# ============================================================================
# TRAP - Field Kit & Lab Environment Variables (Example)
# Copy to .env and customize for local scripts. Never commit .env!
# ============================================================================

# --- WiFi Pineapple Management ---
PINEAPPLE_IP="172.16.42.1"
PINEAPPLE_PORT="1471"
PINEAPPLE_USER="root"
PINEAPPLE_IFACE="eth0"

# --- GoHakMe / OpenWrt Travel Router ---
ROUTER_IP="192.168.8.1"
ROUTER_SSH_PORT="22"
WG_ENDPOINT="vpn.example.com:51820"

# --- Wireless Auditing Interfaces ---
WLAN_MGMT_IFACE="wlan0"
WLAN_MON_IFACE="wlan1mon"

# --- Hak5 Cloud C2 (Self-Hosted) ---
C2_HOSTNAME="c2.example.internal"
C2_PORT="8080"
